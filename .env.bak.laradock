APP_NAME=parts-manager
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=parts_manager
DB_USERNAME=root
DB_PASSWORD=root

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=redis
REDIS_PASSWORD=secret_redis
REDIS_PORT=6379

TEXTS_DIR=/var/www/webapp/public/landisk

CHATGPT_PROMPT_PREFIX_TXT=storage/texts/chatgpt_prompt_prefix.txt
CHATGPT_MODEL=gpt-4o
CHATGPT_MODEL_TEST=openai/gpt-4o
CHATGPT_APIKEY=sk-proj-
CHATGPT_APIKEY_TEST=github_pat_
CHATGPT_API_URL=https://api.openai.com/v1/responses
CHATGPT_API_URL_TEST=https://models.github.ai/inference/chat/completions
